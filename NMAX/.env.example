# NMA 后端环境配置（复制为 .env 使用）
# 注意：.env 不提交 Git，仅保留本示例

DJANGO_SECRET_KEY=django-insecure-change-me-to-a-long-random-string
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=*

# 数据库（本地 PostgreSQL）
DB_NAME=nma
DB_USER=postgres
DB_PASSWORD=123456
DB_HOST=127.0.0.1
DB_PORT=5432
DB_CONN_MAX_AGE=60

# JWT
JWT_ACCESS_MINUTES=30
JWT_REFRESH_DAYS=7

# Redis / Celery
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# 登录锁定
LOGIN_MAX_ATTEMPTS=5
ACCOUNT_LOCKOUT_MINUTES=30

# CORS（前端地址）
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
