# NMA 后端环境配置（开发环境示例）
# 复制为 .env 使用

DJANGO_SECRET_KEY=django-insecure-change-me-in-production
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=*

# 数据库（本地 PostgreSQL）
DB_NAME=nma
DB_USER=postgres
DB_PASSWORD=123456
DB_HOST=127.0.0.1
DB_PORT=5432

# JWT
JWT_ACCESS_MINUTES=30
JWT_REFRESH_DAYS=7

# Redis / Celery
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
